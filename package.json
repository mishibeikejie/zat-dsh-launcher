{
  "name": "zat-dsh-launcher",
  "version": "1.4.0",
  "description": "ZAT-DSH 启动器：多终端 DeepSeek Harness 桌面管理器（安装、启动、监控、更新、救援，终端之间 100% 独立）",
  "main": "main.js",
  "author": "ZAT-DSH Launcher",
  "license": "MIT",
  "scripts": {
    "make:icon": "node scripts/make-icon.js",
    "postinstall": "node scripts/make-icon.js",
    "check": "node --check main.js && node --check preload.js && node --check renderer/renderer.js && node --check scripts/make-icon.js && node --test tests/*.test.js",
    "test": "node --test tests/*.test.js",
    "start": "node scripts/make-icon.js && electron .",
    "dev": "node scripts/make-icon.js && electron .",
    "dist": "node scripts/make-icon.js && electron-builder && node scripts/clean-dist.cjs",
    "pack:dir": "node scripts/make-icon.js && electron-builder --dir"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.zat.dsh-launcher",
    "productName": "ZAT-DSH启动器",
    "copyright": "Copyright © 2026 ZAT-DSH Launcher contributors",
    "asar": true,
    "asarUnpack": [
      "scripts/session-tail.cjs",
      "src/session-activity.js",
      "assets/pnpm.cjs"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "scripts/session-tail.cjs",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ZAT-DSH启动器",
      "artifactName": "ZAT-DSH启动器 Setup ${version}.exe"
    }
  }
}
